{% extends "partials/layout.njk" %}
{% from "components/card.njk" import card %}

{% set pageTitle = "Organisations - " + applicationName %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l" data-qa="main-heading">Organisations</h1>
    </div>
  </div>

  <div class="card-group" data-qa="homepage-cards">
    {% if user | hasPermission(PERMISSION.MANAGE) %}
      {{ card({
        heading: "Add an organisation",
        description: "Create a new organisation, with its contact details and addresses.",
        href: "/organisations/create",
        dataQa: "add-organisation-card"
      }) }}
    {% endif %}
  </div>
{% endblock %}
