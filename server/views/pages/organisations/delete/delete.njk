{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageTitle = "Delete organisation - Organisations" %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-qa="caption">{{ organisation.organisationName }}</span>
      <h1 class="govuk-heading-l" data-qa="main-heading">Are you sure you want to delete this organisation?</h1>

      {{ govukWarningText({
        text: "This permanently deletes the organisation and all of its addresses, phone numbers and email and web addresses. This cannot be undone.",
        iconFallbackText: "Warning"
      }) }}

      <form method="POST" novalidate data-qa="delete-organisation-form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Delete organisation", classes: "govuk-button--warning", preventDoubleClick: true, attributes: { "data-qa": "confirm-delete-button" } }) }}
          <a class="govuk-link govuk-link--no-visited-state" href="/organisations/{{ organisation.organisationId }}" data-qa="cancel-link">Cancel and return to organisation</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
