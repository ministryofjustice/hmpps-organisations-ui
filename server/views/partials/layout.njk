{% extends "govuk/template.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "moj/components/alert/macro.njk" import mojAlert %}

{% block head %}
  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet"/>

  {% for js in feComponents.jsIncludes %}
    <script src="{{ js }}" nonce="{{ cspNonce }}"></script>
  {% endfor %}

  {% for css in feComponents.cssIncludes %}
    <link href="{{ css }}" nonce="{{ cspNonce }}" rel="stylesheet" />
  {% endfor %}
{% endblock %}

{% block pageTitle %}{% if validationErrors and validationErrors.length %}Error: {% endif %}{{ pageTitle | default(applicationName) }}{% endblock %}

{% block header %}
  {% if feComponents.header %}
    {{ feComponents.header | safe }}
  {% else %}
    {% include "./header.njk" %}
  {% endif %}
{% endblock %}

{% block footer %}
  {% if feComponents.footer %}
    {{ feComponents.footer | safe }}
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}

{% block beforeContent %}
  {% if backUrl %}
    {{ govukBackLink({ text: "Back", href: backUrl, attributes: { "data-qa": "back-link" } }) }}
  {% endif %}
{% endblock %}

{% block content %}
  {% if validationErrors and validationErrors.length %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: validationErrors,
      attributes: { "data-qa": "error-summary" }
    }) }}
  {% endif %}

  {% if successMessage %}
    {{ mojAlert({
      variant: "success",
      title: successMessage.heading,
      text: successMessage.message,
      showTitleAsHeading: true,
      dismissible: false,
      attributes: { "data-qa": "success-banner" }
    }) }}
  {% endif %}

  {% block pageContent %}{% endblock %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ '/assets/js/index.js' | assetMap }}"></script>
{% endblock %}
